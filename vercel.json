{
    "version": 2,
    "builds": [
        {
            "src": "server.js",  
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",     
            "dest": "/server.js"
        }
    ],
    "crons": [
        {
            "path": "/prueba-cron",
            "schedule": "0 5 * * *"
        }
    ]
}